NODE_ENV="production"
HOST="127.0.0.1"
PORT="3000"
APP_URL="https://app.poporganize.com.br"
POP_API_BASE_URL="https://app.poporganize.com.br/api/mobile"
APPLE_CLIENT_ID="br.com.poporganize.app"
DATABASE_URL="mysql://USUARIO:SENHA@HOST:3306/NOME_DO_BANCO"
BOOTSTRAP_COMPANY_NAME="Pop Organize"
BOOTSTRAP_ADMIN_NAME="Administrador"
BOOTSTRAP_ADMIN_EMAIL="admin@poporganize.com"
BOOTSTRAP_ADMIN_PASSWORD="gere-uma-senha-com-no-minimo-12-caracteres"
BOOTSTRAP_SEED_DEMO="false"
AUTH_PASSWORD_PEPPER="gere-com-openssl-rand-hex-32"
GOOGLE_CLIENT_ID="seu-client-id.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="seu-client-id.apps.googleusercontent.com"
SMTP_HOST="email-ssl.com.br"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="acesso@seudominio.com.br"
SMTP_PASSWORD="senha-da-conta-de-email"
EMAIL_FROM="acesso@seudominio.com.br"
OPENAI_API_KEY="sk-proj-sua-chave-da-openai"
OPENAI_MODEL="gpt-5.6-luna"
OPENAI_TRANSCRIBE_MODEL="gpt-4o-mini-transcribe"

# Alternativa a android/keystore.properties para builds assinados no CI:
POP_ANDROID_KEYSTORE_PATH="C:/caminho-seguro/pop-organize-upload.jks"
POP_ANDROID_KEYSTORE_PASSWORD="senha-do-keystore"
POP_ANDROID_KEY_ALIAS="pop-organize-upload"
POP_ANDROID_KEY_PASSWORD="senha-da-chave"

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".TaskSchedulePreviewActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Prévia local de horários" />
        <receiver
            android:name=".notifications.TestNotificationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="br.com.poporganize.app.TEST_NOTIFICATION" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".CalendarPreviewActivity"
            android:enabled="${calendarPreviewEnabled}"
            android:exported="true"
            android:label="Prévia Pop Organize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
